<Window x:Class="ILPatchStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ILPatchStudio"
        Title="IL Patch Studio" Width="1260" Height="860" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F2F6FA" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13" AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnWindowKey">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="IL Patch Studio" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button DockPanel.Dock="Left" Content="{local:LocalText Zh='打开 DLL…', En='Open DLL…'}" Click="OnOpen" Margin="0,0,8,0"/>
            <Button x:Name="AddDependencyButton" DockPanel.Dock="Left" Content="{local:LocalText Zh='添加依赖目录…', En='Add dependencies…'}" Click="OnAddDependency" Margin="0,0,12,0"/>
            <Button DockPanel.Dock="Right" Click="OnSettings" Content="{local:LocalText Zh='设置…', En='Settings…'}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Click="OnRecent" Content="{local:LocalText Zh='最近打开', En='Recent'}" Margin="8,0,0,0"/>
            <TextBlock x:Name="AssemblyLabel" Text="{local:LocalText Zh='打开或拖入包含方法体的 .NET DLL', En='Open or drop a .NET DLL with method bodies'}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="255" MinWidth="170"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*" MinWidth="625"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="Sidebar" Background="White" BorderBrush="{StaticResource LineBrush}">
                <TabItem Header="{local:LocalText Zh='方法', En='Methods'}">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <Button DockPanel.Dock="Right" x:Name="ClearSearch" Content="×" MinWidth="28" Padding="4,0"
                                    Click="OnClearSearch" ToolTip="{local:LocalText Zh='清空搜索', En='Clear search'}" AutomationProperties.Name="{local:LocalText Zh='清空搜索', En='Clear search'}"/>
                            <Grid>
                                <TextBox x:Name="SearchBox" TextChanged="OnFilterChanged" PreviewKeyDown="OnSearchKey"
                                         ToolTip="{local:LocalText Zh='方法名、类名或类名.方法名。上下键浏览，Enter 打开，Esc 清空。', En='Search method, type, or Type.Method. Use arrows to browse, Enter to open, Esc to clear.'}"
                                         AutomationProperties.Name="{local:LocalText Zh='搜索方法', En='Search methods'}"/>
                                <TextBlock x:Name="SearchHint" Text="{local:LocalText Zh='搜索方法名或类名', En='Search methods or types'}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="7,0" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="MethodCount" Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}"/>
                        <ListBox x:Name="Methods" SelectionChanged="OnMethodChanged" BorderThickness="0"
                                 AutomationProperties.Name="{local:LocalText Zh='方法列表', En='Method list'}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4" ToolTip="{Binding Signature}">
                                        <TextBlock Text="{Binding MethodName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ShortTypeName}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="DependenciesTab" Header="{local:LocalText Zh='依赖 (0)', En='Dependencies (0)'}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{local:LocalText Zh='添加目录…', En='Add folder…'}" Click="OnAddDependency" Margin="0,0,6,0"/>
                            <Button x:Name="RemoveDependency" Content="{local:LocalText Zh='移除目录', En='Remove folder'}" IsEnabled="False" Click="OnRemoveDependency"/>
                        </StackPanel>
                        <TreeView x:Name="Dependencies" BorderThickness="0" SelectedItemChanged="OnDependencySelected"
                                  AutomationProperties.Name="{local:LocalText Zh='当前依赖目录和程序集引用', En='Dependency folders and assembly references'}" />
                    </DockPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="SourceRow" Height="2*" MinHeight="100"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition x:Name="DraftRow" Height="*" MinHeight="215"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="MethodLabel" Text="{local:LocalText Zh='选择一个方法', En='Select a method'}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SourceColumn" Width="*" MinWidth="220"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition x:Name="IlColumn" Width="0.95*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{local:LocalText Zh='反编译 C# · 点选符号，或选中整句插入代码', En='Decompiled C# · Select a symbol or a full statement'}" Margin="0,0,0,5"/>
                        <TextBox x:Name="SourceBox" Style="{StaticResource CodeBox}" SelectionChanged="OnSourceSelected"
                                 AutomationProperties.Name="{local:LocalText Zh='反编译 C#', En='Decompiled C#'}"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{local:LocalText Zh='原始 IL · 可直接选择指令', En='Raw IL · Select an instruction'}" Margin="0,0,0,5"/>
                        <ListBox x:Name="Instructions" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                 BorderBrush="{StaticResource LineBrush}" Background="#FCFDFE"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 SelectionChanged="OnInstructionSelected" AutomationProperties.Name="{local:LocalText Zh='原始 IL', En='Raw IL'}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCandidate}" Value="True">
                                            <Setter Property="Background" Value="#D8EAF8"/>
                                            <Setter Property="Foreground" Value="#113F67"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" ToolTip="{Binding Text}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
                <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" Background="Transparent"/>
                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="9">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="{local:LocalText Zh='补丁草稿', En='Patch draft'}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox DockPanel.Dock="Left" x:Name="Operation" Width="160" Height="28" IsEnabled="False"
                                      SelectionChanged="OnDraftChanged" DisplayMemberPath="Label" Margin="0,0,7,0"
                                      AutomationProperties.Name="{local:LocalText Zh='补丁操作', En='Patch operation'}"/>
                            <Button DockPanel.Dock="Right" x:Name="CopyButton" Content="{local:LocalText Zh='复制草稿', En='Copy draft'}" IsEnabled="False"
                                    Click="OnCopy" MinHeight="28" Margin="7,0,0,0"/>
                            <Button DockPanel.Dock="Right" x:Name="InputButton" Content="{local:LocalText Zh='传入变量…', En='Pass variables…'}" IsEnabled="False"
                                    Click="OnPatchInputs" MinHeight="28" Margin="7,0,0,0"/>
                            <Grid>
                                <TextBox x:Name="Replacement" MinHeight="28" MaxHeight="75" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextChanged="OnDraftChanged" IsEnabled="False"
                                         AutomationProperties.Name="{local:LocalText Zh='替换值、C# 表达式或语句', En='Replacement, C# expression, or statement'}"/>
                                <ComboBox x:Name="Redirect" Height="28" Visibility="Collapsed" DisplayMemberPath="Label"
                                          SelectionChanged="OnDraftChanged" AutomationProperties.Name="{local:LocalText Zh='写入目标局部变量', En='Destination local variable'}"/>
                            </Grid>
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="{local:LocalText Zh='找不到匹配', En='If no match'}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="MissingPolicy" Width="94" SelectedIndex="0" SelectionChanged="OnDraftChanged"
                                      AutomationProperties.Name="{local:LocalText Zh='找不到匹配时', En='If no match'}" Margin="0,0,12,0">
                                <ComboBoxItem Content="{local:LocalText Zh='抛出异常', En='Throw'}"/>
                                <ComboBoxItem Content="{local:LocalText Zh='跳过补丁', En='Skip patch'}"/>
                            </ComboBox>
                            <CheckBox x:Name="CheckDuplicates" Content="{local:LocalText Zh='重复时抛错', En='Throw on duplicates'}" VerticalAlignment="Center"
                                      Checked="OnDraftChanged" Unchecked="OnDraftChanged" Margin="0,0,12,0"
                                      ToolTip="{local:LocalText Zh='未勾选时，运行时使用第一个匹配。', En='When off, use the first runtime match.'}"/>
                            <CheckBox x:Name="CheckBoundaries" Content="{local:LocalText Zh='检查注入边界', En='Check boundaries'}" VerticalAlignment="Center"
                                      Checked="OnDraftChanged" Unchecked="OnDraftChanged" Margin="0,0,12,0"
                                      ToolTip="{local:LocalText Zh='为委托注入生成 IL 前缀和异常处理边界检查。', En='Check IL prefixes and exception boundaries before emitting a delegate.'}"/>
                            <CheckBox x:Name="PreferMember" Content="{local:LocalText Zh='优先成员锚点', En='Prefer member anchors'}" VerticalAlignment="Center"
                                      Checked="OnDraftChanged" Unchecked="OnDraftChanged" Margin="0,0,5,0"
                                      ToolTip="{local:LocalText Zh='优先用附近的方法或字段签名。关闭时选用最短的唯一模式。', En='Prefer nearby member signatures. When off, use the shortest unique pattern.'}"/>
                            <CheckBox x:Name="IncludeUsings" Content="{local:LocalText Zh='包含 using', En='Include using'}"
                                      VerticalAlignment="Center" Checked="OnDraftChanged" Unchecked="OnDraftChanged"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="RequiredNamespaces" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="SelectedInputs" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="PatchInfo" Text="{local:LocalText Zh='在 C# 或 IL 中选择要修改的位置。', En='Select where to patch in C# or IL.'}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox x:Name="DraftBox" Style="{StaticResource CodeBox}" AutomationProperties.Name="{local:LocalText Zh='生成的补丁代码', En='Generated patch code'}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="2" Foreground="{StaticResource MutedBrush}"
                   Text="{local:LocalText Zh='打开程序集后可搜索类名或方法名。', En='Open an assembly to search its types and methods.'}" Margin="1,8,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
